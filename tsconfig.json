{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",

    // "rootDir": "./src",
    // "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["/**/*.ts"],
  "exclude": ["node_modules"]
}